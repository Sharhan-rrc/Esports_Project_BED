{
  "openapi": "3.0.0",
  "info": {
    "title": "Esports Hub API Documentation",
    "version": "1.0.0",
    "description": "API documentation for the Esports Hub backend application."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Player": {
        "type": "object",
        "required": [
          "id",
          "username",
          "email",
          "organization"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Player unique identifier",
            "example": "player_abc123xyz789"
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "description": "Player username",
            "example": "ProGamer92"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Player email address",
            "example": "player@esports.com"
          },
          "organization": {
            "type": "string",
            "description": "Organization/team name",
            "example": "team_456def"
          },
          "blacklisted": {
            "type": "boolean",
            "default": false,
            "description": "Whether player is blacklisted"
          },
          "blacklistReason": {
            "type": "string",
            "description": "Reason for blacklist if applicable"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When player was created"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When player was last updated"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/admin/bootstrap": {
      "post": {
        "summary": "Bootstrap first admin user (one-time only)",
        "tags": [
          "Admin"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "admin@esports.com"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "example": "SecurePassword123!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Admin user created successfully"
          },
          "409": {
            "description": "Admin already exists"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/admin/assign-role": {
      "post": {
        "summary": "Assign role to user (admin only)",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "uid",
                  "role"
                ],
                "properties": {
                  "uid": {
                    "type": "string",
                    "example": "user_abc123"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "admin",
                      "enforcer",
                      "organizer",
                      "officer"
                    ],
                    "example": "enforcer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Role assigned successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - admin only"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/admin/users/{uid}": {
      "get": {
        "summary": "Get user details (admin only)",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User details"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - admin only"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/admin/users/{uid}/disable": {
      "post": {
        "summary": "Disable user account (admin only)",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User disabled"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - admin only"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/admin/users/{uid}/enable": {
      "post": {
        "summary": "Enable user account (admin only)",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User enabled"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - admin only"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/admin/players/deleted": {
      "get": {
        "summary": "Get all deleted players (admin only)",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of deleted players with deletion timestamps"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - admin only"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login user with Firebase token",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "example": "firebase-id-token-here"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid token"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get current authenticated user information",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User information retrieved successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/integrity/scan/{playerId}": {
      "post": {
        "summary": "Scan player for integrity violations using AI (admin only)",
        "tags": [
          "Integrity"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Player scanned, integrity case created with AI analysis"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - admin only"
          },
          "404": {
            "description": "Player not found"
          }
        }
      }
    },
    "/integrity/cases": {
      "get": {
        "summary": "Get all integrity investigation cases (admin only)",
        "tags": [
          "Integrity"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "investigating",
                "resolved",
                "false_positive"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of integrity cases"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - admin only"
          }
        }
      }
    },
    "/integrity/cases/{caseId}": {
      "get": {
        "summary": "Get detailed integrity case information with AI analysis (admin only)",
        "tags": [
          "Integrity"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "caseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed case information with flags and AI analysis"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - admin only"
          },
          "404": {
            "description": "Case not found"
          }
        }
      },
      "patch": {
        "summary": "Update integrity case status and notes (admin only)",
        "tags": [
          "Integrity"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "caseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "open",
                      "investigating",
                      "resolved",
                      "false_positive"
                    ]
                  },
                  "adminNotes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Case updated"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - admin only"
          },
          "404": {
            "description": "Case not found"
          }
        }
      }
    },
    "/players/{playerId}/blacklist": {
      "post": {
        "summary": "Blacklist a player (admin and enforcer)",
        "tags": [
          "Players"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Player blacklisted"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Player not found"
          }
        }
      },
      "delete": {
        "summary": "Unblacklist a player (admin and enforcer)",
        "tags": [
          "Players"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Player unblacklisted"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Player not found"
          }
        }
      }
    },
    "/players/{playerId}/stats": {
      "put": {
        "summary": "Update player statistics and recalculate rating (admin and enforcer)",
        "tags": [
          "Players"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "wins": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "losses": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "totalKills": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "totalDeaths": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stats updated and rating recalculated"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/players": {
      "post": {
        "summary": "Create a new player with optional initial stats (admin, organizer)",
        "tags": [
          "Players"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "email",
                  "organization"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "ProGamer92"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "player@esports.com"
                  },
                  "organization": {
                    "type": "string",
                    "example": "team_456def"
                  },
                  "wins": {
                    "type": "integer",
                    "minimum": 0,
                    "example": 45
                  },
                  "losses": {
                    "type": "integer",
                    "minimum": 0,
                    "example": 15
                  },
                  "totalKills": {
                    "type": "integer",
                    "minimum": 0,
                    "example": 450
                  },
                  "totalDeaths": {
                    "type": "integer",
                    "minimum": 0,
                    "example": 150
                  },
                  "matchesLast30Days": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 30,
                    "example": 22
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Player created successfully with calculated rating"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - insufficient role"
          }
        }
      },
      "put": {
        "summary": "Update player information (admin, organizer)",
        "tags": [
          "Players"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "organization": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Player updated"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Player not found"
          }
        }
      },
      "get": {
        "summary": "Get all players (admin, organizer, enforcer, officer)",
        "tags": [
          "Players"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 100
            }
          },
          {
            "name": "includeDeleted",
            "in": "query",
            "description": "Include soft-deleted players in list results",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of players"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/players/{playerId}": {
      "get": {
        "summary": "Get player by ID (admin, organizer, enforcer, officer)",
        "tags": [
          "Players"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Player details"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Player not found"
          }
        }
      },
      "delete": {
        "summary": "Permanently delete player (admin only - HARD DELETE)",
        "tags": [
          "Players"
        ],
        "description": "PERMANENT deletion - completely removes player record from database. Use for major violations or data cleanup only. This action cannot be undone.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Player permanently deleted from system",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "permanently_deleted": {
                          "type": "boolean"
                        }
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - no authentication token"
          },
          "403": {
            "description": "Forbidden - admin role required"
          },
          "404": {
            "description": "Player not found"
          }
        }
      }
    },
    "/players/{playerId}/rating": {
      "get": {
        "summary": "Get player rating information (admin, organizer, enforcer, officer)",
        "tags": [
          "Players"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Player rating details"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Player not found"
          }
        }
      }
    }
  },
  "tags": []
}